# Backend build context — keep it small and never ship local venvs/secrets.
.venv/
__pycache__/
**/__pycache__/
*.pyc
.pytest_cache/
.git/
.gitignore

# Frontend lives in its own image.
web/

# Local-only artifacts.
uploads/
output/
docs/
tests/
harness.db
harness.db-wal
harness.db-shm
scripts/bin/harness-cli
scripts/bin/harness-cli.exe

# Secrets are injected via env_file at runtime, not baked into the image.
.env
.env.local
