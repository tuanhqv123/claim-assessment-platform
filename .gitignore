# ── Secrets / env (NEVER commit) ──
.env
.env.*.local
**/.env.local
*.pem
# .env.example is kept as a template (different filename, not matched above)

# ── Python ──
.venv/
__pycache__/
**/__pycache__/
*.pyc
.pytest_cache/

# ── Node / Next.js (web/) ──
node_modules/
**/node_modules/
.next/
**/.next/
out/
*.tsbuildinfo

# ── Runtime / scratch ──
output/
uploads/*
!uploads/.gitkeep
build.log

# ── Test/sample data + internal tooling (kept locally, not in the product repo) ──
data/sample_docs/
scripts/

# ── Harness (internal tracking — not part of the product) ──
harness.db
harness.db-wal
harness.db-shm
scripts/bin/harness-cli
scripts/bin/harness-cli.exe
docs/

# ── OS ──
.DS_Store
**/.DS_Store
